<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.contestclient.LoginController">
   <children>
      <Label alignment="CENTER" layoutX="219.0" layoutY="20.0" text="Log In" textAlignment="CENTER" textFill="#1a7fa4">
         <font>
            <Font name="Perpetua" size="69.0" />
         </font>
      </Label>
      <TextField fx:id="textfield_email" layoutX="224.0" layoutY="174.0" />
      <Label alignment="CENTER" contentDisplay="CENTER" layoutX="259.0" layoutY="123.0" text="Email:" textFill="#d75cb2">
         <font>
            <Font name="Palatino Linotype" size="28.0" />
         </font>
      </Label>
      <Label alignment="CENTER" contentDisplay="CENTER" layoutX="234.0" layoutY="217.0" text="Password:" textFill="#d75cb2">
         <font>
            <Font name="Palatino Linotype" size="28.0" />
         </font>
      </Label>
      <PasswordField fx:id="textfield_pswd" layoutX="224.0" layoutY="270.0" />
      <Button fx:id="button_login" layoutX="262.0" layoutY="323.0" mnemonicParsing="false" onAction="#onLogIn" text="Login" textFill="#1a7fa4">
         <font>
            <Font size="19.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
